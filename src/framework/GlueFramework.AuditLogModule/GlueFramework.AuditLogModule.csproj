<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Glue Freamework Aduit Log Module</Title>
		<Version>1.0.1</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<Title>Glue Freamework Aduit Log Module</Title>
		<PublishWebProject>false</PublishWebProject>
		<EnableSdkDefaultItems>true</EnableSdkDefaultItems>
		<IsPackable>true</IsPackable>

		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/**;appsettings*.json</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Data.Abstractions" Version="3.0.0" />
    <PackageReference Include="OrchardCore.Data.YesSql.Abstractions" Version="3.0.0" />
    <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.0" />
    <PackageReference Include="OrchardCore.Admin" Version="3.0.0" />
    <PackageReference Include="OrchardCore.Navigation.Core" Version="3.0.0" />
    <PackageReference Include="OrchardCore.Security" Version="3.0.0" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<PackageReference Include="Serilog.Filters.Expressions" Version="2.1.0" />
	</ItemGroup>



	<ItemGroup>
		<ProjectReference Include="..\GlueFramework.AuditLog.Abstractions\GlueFramework.AuditLog.Abstractions.csproj" />
		<ProjectReference Include="..\GlueFramework.Core\GlueFramework.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>

</Project>
